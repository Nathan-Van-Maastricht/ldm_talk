\begin{center}
        \resizebox{\textwidth}{!}{
    \begin{tikzpicture}[
        node distance=1.5cm,
        block/.style={draw, fill=blue!10, minimum width=1.1cm, minimum height=0.8cm, rounded corners=2pt, font=\scriptsize, align=center},
        io/.style={font=\tiny\bfseries, gray},
        skip/.style={->, red!60, ultra thick, >=stealth},
    ]
        % Top Row: Encoder
        \node [block] (b1) {Block 1};
        \node [block, right of=b1] (b2) {Block 2};
        \node [block, right of=b2] (b3) {Block 3};
        \node [block, right of=b3] (b4) {Block 4};
        \node [block, right of=b4] (b5) {Block 5};
        \node [block, right of=b5] (b6) {Block 6};
        \node [block, right of=b6] (b7) {Block 7};
        \node [block, right of=b7] (b8) {Block 8};

        % Bottom Row: Decoder (Aligned under Encoder)
        \node [block, below of=b8, yshift=-0.5cm] (b9) {Block 9};
        \node [block, left of=b9] (b10) {Block 10};
        \node [block, left of=b10] (b11) {Block 11};
        \node [block, left of=b11] (b12) {Block 12};
        \node [block, left of=b12] (b13) {Block 13};
        \node [block, left of=b13] (b14) {Block 14};
        \node [block, left of=b14] (b15) {Block 15};
        \node [block, left of=b15] (b16) {Block 16};

        % Flow Arrows
        \draw [->, thick] (b1) -- (b2);
        \draw [->, thick] (b2) -- (b3);
        \draw [->, thick] (b3) -- (b4);
        \draw [->, thick] (b4) -- (b5);
        \draw [->, thick] (b5) -- (b6);
        \draw [->, thick] (b6) -- (b7);
        \draw [->, thick] (b7) -- (b8);
        \draw [->, thick] (b8) -- (b9); % The "Turn"
        \draw [->, thick] (b9) -- (b10);
        \draw [->, thick] (b10) -- (b11);
        \draw [->, thick] (b11) -- (b12);
        \draw [->, thick] (b12) -- (b13);
        \draw [->, thick] (b13) -- (b14);
        \draw [->, thick] (b14) -- (b15);
        \draw [->, thick] (b15) -- (b16);

        % Skip Connections (Vertical)
        \draw [skip] (b1) -- (b16) node[midway, right, black, scale=0.6] {Add};
        \draw [skip] (b2) -- (b15);
        \draw [skip] (b3) -- (b14);
        \draw [skip] (b4) -- (b13);
        \draw [skip] (b5) -- (b12);
        \draw [skip] (b6) -- (b11);
        \draw [skip] (b7) -- (b10);

        % Input/Output labels
        \node [left of=b1, xshift=0.3cm, io] {Input};
        \node [left of=b16, xshift=0.3cm, io] {Output};

    \end{tikzpicture}
        }
    \end{center}
